# ===========================
# ForgeMind Environment Variables
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# ===========================

# --- Application ---
APP_ENV=development
APP_PORT=8080
FRONTEND_PORT=5173

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=forgemind
POSTGRES_USER=forgemind
POSTGRES_PASSWORD=forgemind_dev_password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT (required for Phase 2 - Auth) ---
JWT_SECRET=change_this_to_a_strong_random_256_bit_secret_before_use
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# --- AI Providers (required for Phase 3 - AI Infrastructure) ---
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- GitHub Integration (required for Phase 7) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Workspace Storage ---
WORKSPACE_BASE_PATH=/tmp/forgemind/workspaces

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
